-- Journal, sleep tracking and meditation history.
CREATE TABLE journal_entry(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    type TEXT NOT NULL,              -- 'DREAM' or 'NOTE'
    created_at INTEGER NOT NULL,     -- epoch millis
    rating INTEGER NOT NULL DEFAULT 0, -- 0..5 stars
    text TEXT NOT NULL
);

CREATE TABLE sleep_session(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    started_at INTEGER NOT NULL,     -- epoch millis
    ended_at INTEGER,
    alarm_at INTEGER,                -- planned wake-up, epoch millis
    quality INTEGER                  -- 1..5, asked on wake-up
);

CREATE TABLE meditation_session(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mood TEXT NOT NULL,
    completed_at INTEGER NOT NULL,   -- epoch millis
    duration_ms INTEGER NOT NULL
);
