-- User.sq

CREATE TABLE user(
    id TEXT NOT NULL PRIMARY KEY,
    email TEXT NOT NULL UNIQUE,
    password TEXT NOT NULL, -- In a real app, hash this before saving!
    username TEXT,
    is_logged_in INTEGER NOT NULL DEFAULT 0
);

-- Register a new user
insertUser:
INSERT OR REPLACE INTO user(id, email, password, username, is_logged_in)
VALUES (?, ?, ?, ?, ?);

-- Get user by email (for login check)
getUserByEmail:
SELECT * FROM user WHERE email = ?;

-- Get the currently logged in user (if any)
getLoggedInUser:
SELECT * FROM user WHERE is_logged_in = 1 LIMIT 1;

-- Log out everyone (reset flag)
logoutAll:
UPDATE user SET is_logged_in = 0;

-- Set specific user as logged in
loginUser:
UPDATE user SET is_logged_in = 1 WHERE id = ?;