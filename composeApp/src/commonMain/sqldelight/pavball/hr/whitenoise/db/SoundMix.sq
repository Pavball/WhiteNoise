-- Mixes the user saved from the sound mixer.
CREATE TABLE sound_mix(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    lead_sound_id TEXT NOT NULL,
    lead_volume REAL NOT NULL,       -- 0..1
    layers TEXT NOT NULL,            -- "soundId=volume;…", see SoundMix.encodeLayers
    created_at INTEGER NOT NULL      -- epoch millis
);

selectAll:
SELECT * FROM sound_mix ORDER BY created_at DESC;

insertMix:
INSERT INTO sound_mix(name, lead_sound_id, lead_volume, layers, created_at) VALUES (?, ?, ?, ?, ?);

deleteMix:
DELETE FROM sound_mix WHERE id = ?;
